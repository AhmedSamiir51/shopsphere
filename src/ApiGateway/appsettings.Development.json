{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**c}"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/products/{**c}"
        }
      },
      "categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/categories/{**c}"
        }
      },
      "cart": {
        "ClusterId": "cart",
        "Match": {
          "Path": "/api/cart/{**c}"
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**c}"
        }
      },
      "stock": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/stock/{**c}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/{**c}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/{**c}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "cart": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5105/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5106/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d": {
            "Address": "http://localhost:5107/"
          }
        }
      }
    }
  }
}